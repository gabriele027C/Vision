/.env

# ChromaDB generated local storage (rigenerabile con gli script di indexing)
vector_store/

# Vision TVS app (generati a runtime)
src/backend/vision_app.db
src/backend/cache/
src/frontend/node_modules/
src/frontend/dist/
__pycache__/
.pytest_cache/

# Research runtime cache (riproducibile con rebuild-cache)
research/diag_cache/

# Output intermedi parity (le fixture synthetic.json sono versionate)
parity/fixtures/last_*.json

# Residui locali di audit / debug (non versionare)
src/backend/audit_*
src/backend/btc_diag*
src/backend/btc_flow*
src/backend/debug_verify_fasi.py
vision_fix_critici.patch
*.pyc